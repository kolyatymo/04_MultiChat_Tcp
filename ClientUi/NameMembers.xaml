<Window x:Class="ClientUi.NameMembers"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClientUi"
        mc:Ignorable="d"
        Title="NameMembers" Height="300" Width="500">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" TextAlignment="Center" FontWeight="Bold" FontSize="25">Write Name</TextBlock>
        <TextBox DockPanel.Dock="Top" Margin="30" x:Name="MyName" VerticalContentAlignment="Center"></TextBox>
        <Button Click="Button_Click" Background="GreenYellow" Width="80" Height="50">Accept</Button>
    </DockPanel>
</Window>
